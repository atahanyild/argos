# Argos environment configuration. Copy to .env and adjust.
# Keep .env out of version control (see .gitignore) and chmod 600 it.

# Bearer token required by remote clients. Leave empty ONLY for localhost-only
# testing; empty means authentication is disabled. Generate a strong token, e.g.:
#   openssl rand -hex 24
MC_TOKEN=

# Path to the SQLite database file. Defaults to argos.db next to server.py.
MC_DB=

# Interface to bind. Keep 127.0.0.1 and run behind a reverse proxy; do not bind 0.0.0.0.
MC_HOST=127.0.0.1

# TCP port to listen on (behind the reverse proxy).
MC_PORT=8765

# Projects untouched for this many days are marked [STALE] in the overview.
MC_STALE_DAYS=7
